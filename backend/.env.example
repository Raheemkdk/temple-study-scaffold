# Copy to .env. These are names only; do not commit actual secrets.
DATABASE_PATH=./data/study.db

# 32 random bytes, encoded as 64 hex characters or base64.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_ENCRYPTION_KEY=

# Share privately with invited students.
PILOT_INVITE_CODE=

# Origins allowed to call this API with credentials (comma-separated).
# The Vite dev server default is http://localhost:5173.
ALLOWED_ORIGINS=http://localhost:5173

# Set to "true" once the app is served over HTTPS so session cookies get Secure.
COOKIE_SECURE=false

# Google Gemini. Leave GEMINI_API_KEY unset to always use the template fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=300
GEMINI_TIMEOUT_SECONDS=12

# Deferred, not yet implemented in this backend: push notifications, reminders worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com
